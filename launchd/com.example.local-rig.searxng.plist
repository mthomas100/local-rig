<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.local-rig.searxng</string>
  <!-- Local SearXNG on 127.0.0.1:8080 for pi's web tools and Local Deep
       Research. The script holds every setting; see docs/web-research.md. -->
  <key>ProgramArguments</key>
  <array>
    <string>__RIG__/tools/searxng-run.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__SEARXNG_SRC__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Back off 10 s between crash restarts instead of spinning. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.ds4/searxng.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.ds4/searxng.log</string>
</dict>
</plist>
